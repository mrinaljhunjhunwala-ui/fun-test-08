{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "nse-dashboard",
      "runtimeExecutable": "py",
      "runtimeArgs": ["-m", "streamlit", "run", "dashboard/app.py", "--server.port", "8501", "--server.headless", "true"],
      "port": 8501,
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONUTF8": "1",
        "DATABASE_URL": "",
        "PYTHONIOENCODING": "utf-8",
        "NSE_SIDEBAR_QV_OFF": "1",
        "NSE_ACCEPT_STALE_SNAPSHOTS": "1",
        "NSE_QV_MAX_WAIT_SECONDS": "3",
        "NSE_SKIP_LIVE_TOP_PICKS": "1"
      }
    }
  ]
}

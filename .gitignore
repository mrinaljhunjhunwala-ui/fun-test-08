*.swo

# Streamlit secrets (NEVER commit these)
.streamlit/secrets.toml

# SQLite databases (ephemeral — regenerated on startup)
trades.db
*.db
*.sqlite
*.sqlite3

# Personal portfolio holdings (use portfolio.csv.example as the template).
# NOTE: portfolio.csv is currently still tracked to keep the cloud auto-load
# working. To remove your real holdings from the public repo, run:
#   git rm --cached portfolio.csv && git commit -m "stop tracking portfolio.csv"
portfolio.csv

# Background-alert de-dup state (managed by GitHub Actions cache, not source)
data/alert_state.json

# Large data files
*.csv.bak
*.parquet
data/cache/

# Backtest HTML exports (generated output, not source)
backtest_*.html
portfolio_best_*.html

# Backtest result CSVs + metadata sidecar (generated output, not source).
# FIX B6/GAP3 — backtest_results.csv and portfolio_results.csv were
# committed since the repo's very first commit and never gitignored, so a
# fresh checkout ships ~6-week-old sample numbers (predating every backtest
# fix made since) that 08_backtest.py auto-loads and displays as if they
# were a real result. See _load_backtest_meta() in that file: the metadata
# sidecar is what now lets the page tell stale/unknown-origin data apart
# from a real run and warn accordingly, but the right long-term fix is to
# stop committing generated output at all.
backtest_results.csv
portfolio_results.csv
portfolio_results.meta.json

# best_params.json — optimizer output (backtest/optimizer.py), same problem as
# the backtest CSVs above: a committed 5-ticker sample from one arbitrary local
# run, not read back by any code, and easy to mistake for validated defaults.
best_params.json

# Generated scan / coverage reports (regenerated by tools, not source)
fund_coverage.csv
nse_scan_*.csv

# Score-efficacy research outputs (regenerated by research/score_efficacy.py)
research/output/

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/

# Model weights / large binaries
*.pkl
*.joblib
*.h5
*.pt
*.pth

# Local git-bundle backups of retired checkouts (kept off-repo: they carry a
# real portfolio.csv in their history)
archive/

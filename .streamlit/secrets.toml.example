# NSE Smart Investor — Streamlit Secrets Template
#
# USAGE (two options):
#
# A) Streamlit Cloud (deployed app):
#    → App Settings → Secrets → paste the [angel_one] block below with real values
#
# B) Local development:
#    → Copy this file to  .streamlit/secrets.toml  (never commit that file)
#    → Fill in real values
#
# The app works WITHOUT these credentials (falls back to Stooq + Yahoo Finance).
# With credentials: faster data, real-time quotes, no rate limiting.

# ── Angel One SmartAPI ────────────────────────────────────────────────────────
[angel_one]
api_key      = "YOUR_API_KEY_HERE"       # My Smart API page → API Key column
client_id    = "YOUR_CLIENT_ID_HERE"     # Your Angel One login ID (e.g. AABM038127)
password     = "YOUR_LOGIN_PASSWORD"     # Angel One login password
totp_secret  = "YOUR_BASE32_TOTP_SEED"  # See instructions below
page_pin     = "CHOOSE_A_PIN"           # Unlocks the Angel One page (holdings, funds, orders).
                                        # Required: without it the page stays locked.

# How to find your TOTP secret (base32 seed):
#   1. Go to Angel One → Profile → Security Settings → Two-Factor Authentication
#   2. Click "Re-setup" or "Reset Authenticator"
#   3. On the QR code screen, look for "Can't scan? Enter this key manually"
#   4. Copy that text key (looks like: JBSWY3DPEHPK3PXP)
#   5. That is your totp_secret — paste it above
#   6. Also scan the QR into your authenticator app to keep using it normally

# ── Optional: Telegram alerts ─────────────────────────────────────────────────
# [telegram]
# bot_token = "YOUR_BOT_TOKEN"    # from @BotFather
# chat_id   = "YOUR_CHAT_ID"      # your Telegram user/channel ID

# ── Optional: Postgres persistence (paper trades / watchlist survive redeploys) ──
# Without this, the app falls back to local SQLite, which resets on every
# redeploy. See dashboard/DB_SETUP.md for the full walkthrough (e.g. Neon).
# Either form works — pick one:
#
# DATABASE_URL = "postgresql://user:password@ep-xxx.aws.neon.tech/neondb?sslmode=require"
#
# [database]
# url = "postgresql://user:password@ep-xxx.aws.neon.tech/neondb?sslmode=require"
